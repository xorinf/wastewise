# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/wastewise

# JWT
JWT_SECRET=replace-me-with-something-long-and-random
JWT_EXPIRES_IN=7d

# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Cloudinary (optional - app works without; if blank, /upload stores base64 only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Vision model (optional - if blank, /identify falls back to quick-select)
VISION_API_URL=
VISION_API_KEY=
